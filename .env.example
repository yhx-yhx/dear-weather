# 和风天气 API Key
# 本地开发：复制为 .env.local 并填入真实 key
# GitHub Pages：在仓库 Settings → Secrets and variables → Actions 添加 QWEATHER_API_KEY
VITE_QWEATHER_API_KEY=

# 和风天气 API Host
# 老 key 一般用 devapi.qweather.com；新 key 请填控制台里的专属 API Host
VITE_QWEATHER_API_HOST=devapi.qweather.com

# 天地图 Key（用于双城地图瓦片）
# GitHub Pages：添加 TDT_MAP_KEY
VITE_TDT_MAP_KEY=
